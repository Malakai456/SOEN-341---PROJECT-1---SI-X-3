<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Profile - CampusEvents</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  {{> navbar }}

  <div class="homepage" style="width:600px; text-align:center;">
    <h1 style="color:#1c5edd;">Welcome, {{user.name}} 👋</h1>
    <p style="margin-top:10px; font-size:18px; color:#333;">Here’s your account information:</p>

    <div style="margin-top:25px; background:#f5f7fa; padding:25px; border-radius:15px;">
      <p><strong>Username:</strong> {{user.username}}</p>
      <p><strong>Email:</strong> {{user.email}}</p>
    </div>

    <div style="margin-top:25px;">
      <a href="/events" style="text-decoration:none;">
        <button style="width:60%; background:#1c5edd;">Browse Events</button>
      </a>
      <a href="/logout" style="text-decoration:none;">
        <button style="width:60%; background:#ff5c5c; margin-top:10px;">Logout</button>
      </a>
    </div>
  </div>
</body>
</html>
