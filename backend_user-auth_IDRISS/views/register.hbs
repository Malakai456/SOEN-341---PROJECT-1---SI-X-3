<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="styles.css">
    <title> Registering Page</title>
</head>

<body>
    <header>

        <h2 class="logo">
            <!-- <img src="CU-logo-design-vector-Graphics-18354798-1.jpg" alt="CampusConnect Logo"> -->
        </h2>

        <h2 class="companyname"><a href="/" style="color: inherit; text-decoration: none;">CampusEvents</a></h2>

        <nav class="navigation">
            <a href="/"> Home</a>
            <a href="/contact"> Contact</a>
            <a href="/register" class="signInButton">Register</a>
            <a href="/login" class="loginbutton">Log In</a>
        </nav>
    </header>
    <h1 id="companyname"></h1>
    <div class="registerpage">
        {{#if message}}
        <p class="error-message">{{message}}</p>
        {{/if}}

        <form action="/register" method="POST">
            <h1>Register</h1>

            <div class="input-text">
                <input type="text" name="first_name" placeholder="First Name" required>
            </div>

            <div class="input-text">
                <input type="text" name="last_name" placeholder="Last Name" required>
            </div>

            <div class="input-text">
                <input type="text" name="username" placeholder="Username" required>
            </div>

            <div class="input-text">
                <input type="email" name="email" placeholder="Email" required>
            </div>

            <div class="input-text">
                <input type="password" name="password" placeholder="Password" required>
            </div>

            <div class="input-text">
                <input type="password" name="confirmPassword" placeholder="Confirm Password" required>
            </div>

            <div class="input-text">
                <input type="text" name="phone_number" placeholder="Phone Number">
            </div>

            <div class="input-text">
                <input type="text" name="address" placeholder="Address">
            </div>
            <button type="submit">Create Account</button>
        </form>
        <!-- <div class="register">
                <a href="./proj.hbs">Return to login page</a>
            </div> -->
        <!-- </div> -->
    </div>
    <!-- <script src="scripts.js"></script> Link to external JavaScript file -->
</body>

</html>